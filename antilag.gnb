local function getService(name)
    local service = game:GetService(name)
    return cloneref and cloneref(service) or service
end

local Players = getService("Players")
local Lighting = getService("Lighting")
local Workspace = getService("Workspace")
local RunService = getService("RunService")
local CoreGui = getService("CoreGui")
local UserInputService = getService("UserInputService")

local lp = Players.LocalPlayer

local function getRandomName()
    local str = ""
    for _ = 1, math.random(8, 14) do
        str = str .. string.char(math.random(97, 122))
    end
    return str
end

local function getGuiParent()
    if gethui then return gethui() end
    local ok, res = pcall(function() return CoreGui:FindFirstChild("RobloxGui") end)
    if ok and res then return res end
    return lp:WaitForChild("PlayerGui")
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = getRandomName()
screenGui.ResetOnSpawn = false
screenGui.Parent = getGuiParent()

local function makeDraggable(guiObject)
    local dragging, dragStart, startPos
    guiObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = guiObject.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            guiObject.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

-- Button 1: Anti-Lag / Brightness
local antiLagBtn = Instance.new("TextButton")
antiLagBtn.Name = getRandomName()
antiLagBtn.Size = UDim2.new(0, 75, 0, 28)
antiLagBtn.Position = UDim2.new(0.01, 0, 0.2, 0)
antiLagBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
antiLagBtn.BorderSizePixel = 1
antiLagBtn.BorderColor3 = Color3.fromRGB(80, 80, 80)
antiLagBtn.Text = "LAG: OFF"
antiLagBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
antiLagBtn.Font = Enum.Font.SourceSansBold
antiLagBtn.TextSize = 11
antiLagBtn.Active = true
antiLagBtn.Parent = screenGui
makeDraggable(antiLagBtn)

-- Button 2: Hide Teammates
local hidePlayersBtn = Instance.new("TextButton")
hidePlayersBtn.Name = getRandomName()
hidePlayersBtn.Size = UDim2.new(0, 75, 0, 28)
hidePlayersBtn.Position = UDim2.new(0.01, 0, 0.26, 0)
hidePlayersBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
hidePlayersBtn.BorderSizePixel = 1
hidePlayersBtn.BorderColor3 = Color3.fromRGB(80, 80, 80)
hidePlayersBtn.Text = "HIDE: OFF"
hidePlayersBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
hidePlayersBtn.Font = Enum.Font.SourceSansBold
hidePlayersBtn.TextSize = 11
hidePlayersBtn.Active = true
hidePlayersBtn.Parent = screenGui
makeDraggable(hidePlayersBtn)

local antiLagActive = false
local hidePlayersActive = false
local renderConnection

-- Disable Weather & Force Fullbright
local function applyFullbright()
    Lighting.ClockTime = 14
    Lighting.Brightness = 3
    Lighting.FogEnd = 1e6
    Lighting.GlobalShadows = false
    Lighting.Ambient = Color3.fromRGB(255, 255, 255)
    Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)

    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") then
            v.Enabled = false
        end
    end

    local weather = Workspace:FindFirstChild("Weather")
    if weather then
        weather.Value = "Clear"
        local freezing = weather:FindFirstChild("Freezing")
        if freezing then freezing.Value = false end
    end
end

antiLagBtn.MouseButton1Click:Connect(function()
    antiLagActive = not antiLagActive
    antiLagBtn.Text = "LAG: " .. (antiLagActive and "ON" or "OFF")
    antiLagBtn.TextColor3 = antiLagActive and Color3.fromRGB(80, 220, 100) or Color3.fromRGB(200, 200, 200)

    if antiLagActive then
        renderConnection = RunService.PreRender:Connect(function()
            if antiLagActive then
                applyFullbright()
            end
        end)

        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
                v.Enabled = false
            end
        end
    else
        if renderConnection then
            renderConnection:Disconnect()
            renderConnection = nil
        end
        
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") then
                v.Enabled = true
            end
        end
    end
end)

Workspace.DescendantAdded:Connect(function(v)
    if antiLagActive and (v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles")) then
        v.Enabled = false
    end
end)

-- Hide Players while keeping NameTags Visible & Through Walls
local storedTransparency = {}

local function processPlayerChar(player, hide)
    if player == lp or not player.Character then return end
    
    local char = player.Character
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("BasePart") or v:IsA("Decal") then
            if hide then
                if not storedTransparency[v] then
                    storedTransparency[v] = v.Transparency
                end
                v.Transparency = 1
            else
                if storedTransparency[v] then
                    v.Transparency = storedTransparency[v]
                    storedTransparency[v] = nil
                end
            end
        elseif v:IsA("BillboardGui") then
            v.Enabled = true
            v.AlwaysOnTop = hide -- Makes name tags visible through walls when hidden
        end
    end
end

hidePlayersBtn.MouseButton1Click:Connect(function()
    hidePlayersActive = not hidePlayersActive
    hidePlayersBtn.Text = "HIDE: " .. (hidePlayersActive and "ON" or "OFF")
    hidePlayersBtn.TextColor3 = hidePlayersActive and Color3.fromRGB(80, 220, 100) or Color3.fromRGB(200, 200, 200)

    for _, player in ipairs(Players:GetPlayers()) do
        processPlayerChar(player, hidePlayersActive)
    end
end)

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        if hidePlayersActive then
            processPlayerChar(player, true)
        end
    end)
end)
