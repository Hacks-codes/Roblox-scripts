local function updateActiveTime()
    if isUsingSecondary then
        activeAutoClickTime = secondaryAutoClickTime
        QuickSwapBtn.Text = "T2"
        QuickSwapBtn.BackgroundColor3 = Color3.fromRGB(180, 80, 40)
    else
        activeAutoClickTime = primaryAutoClickTime
        QuickSwapBtn.Text = "T1"
        QuickSwapBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    end
end

QuickSwapBtn.MouseButton1Click:Connect(function()
    isUsingSecondary = not isUsingSecondary
    updateActiveTime()
end)

local function triggerAutoClick()
    local x = Pointer.AbsolutePosition.X + (Pointer.AbsoluteSize.X / 2)
    local y = Pointer.AbsolutePosition.Y + (Pointer.AbsoluteSize.Y / 2) + 36
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
    task.wait(0.02)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

