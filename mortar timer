local function createToggleBtn(posY, labelText, defaultState, onToggle)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, -16, 0, 22)
    Btn.Position = UDim2.new(0, 8, 0, posY)
    Btn.BackgroundColor3 = defaultState and Color3.fromRGB(40, 140, 70) or Color3.fromRGB(140, 40, 40)
    Btn.Text = labelText .. (defaultState and ": ON" or ": OFF")
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.TextSize = 8
    Btn.Font = Enum.Font.GothamBold
    Btn.Parent = MainMenu

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 4)
    Corner.Parent = Btn

    local state = defaultState
    Btn.MouseButton1Click:Connect(function()
        state = not state
        Btn.BackgroundColor3 = state and Color3.fromRGB(40, 140, 70) or Color3.fromRGB(140, 40, 40)
        Btn.Text = labelText .. (state and ": ON" or ": OFF")
        onToggle(state)
    end)
    return Btn
end

