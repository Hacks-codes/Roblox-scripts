local function createTimerBar(name, defaultPos, labelText)
    local Frame = Instance.new("Frame")
    Frame.Name = name .. "Display"
    Frame.Size = UDim2.new(0, 110, 0, 16)
    Frame.Position = defaultPos
    Frame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    Frame.BorderSizePixel = 0
    Frame.Active = true
    Frame.ClipsDescendants = true
    Frame.Parent = ScreenGui

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 3)
    Corner.Parent = Frame

    local Stroke = Instance.new("UIStroke")
    Stroke.Name = "BorderStroke"
    Stroke.Color = Color3.fromRGB(50, 50, 60)
    Stroke.Thickness = 1
    Stroke.Parent = Frame

    local FillBar = Instance.new("Frame")
    FillBar.Name = "FillBar"
    FillBar.Size = UDim2.new(0, 0, 1, 0)
    FillBar.BackgroundColor3 = Color3.fromRGB(80, 80, 100)
    FillBar.BorderSizePixel = 0
    FillBar.Parent = Frame

    local FillCorner = Instance.new("UICorner")
    FillCorner.CornerRadius = UDim.new(0, 3)
    FillCorner.Parent = FillBar

    local Label = Instance.new("TextLabel")
    Label.Name = "Label"
    Label.Size = UDim2.new(1, 0, 1, 0)
    Label.BackgroundTransparency = 1
    Label.Text = labelText .. ": READY"
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.TextSize = 10
    Label.Font = Enum.Font.GothamBold
    Label.ZIndex = 2
    Label.Parent = Frame

    makeDraggable(Frame, Frame, function() return isMenuOpen end)

    return Frame, Label, FillBar, Stroke
end

