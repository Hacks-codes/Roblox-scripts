--------------------------------------------------------------------------------
-- COUNTDOWN ENGINE
--------------------------------------------------------------------------------

local function triggerReload()
    if isReloading then return end
    isReloading = true
    
    ReloadText.TextColor3 = Color3.fromRGB(255, 255, 255)
    ReloadFill.BackgroundColor3 = Color3.fromRGB(60, 120, 180)
    local startTime = os.clock()
    
    task.spawn(function()
        while true do
            local elapsed = os.clock() - startTime
            local remaining = math.max(0, RELOAD_DURATION - elapsed)
            local progress = math.clamp(elapsed / RELOAD_DURATION, 0, 1)

            ReloadText.Text = string.format("RELOAD: %.2fs", remaining)
            ReloadFill.Size = UDim2.new(progress, 0, 1, 0)

            if remaining <= 0 then break end
            task.wait()
        end

        ReloadText.Text = "RELOAD: READY"
        ReloadFill.Size = UDim2.new(0, 0, 1, 0)
        isReloading = false
    end)
end

local function triggerFuse()
    if isFuseLit then return end
    isFuseLit = true
    
    FuseText.TextColor3 = Color3.fromRGB(255, 255, 255)
    FuseFill.BackgroundColor3 = Color3.fromRGB(180, 80, 40)
    local startTime = os.clock()
    local clicked = false
    
    task.spawn(function()
        while true do
            local elapsed = os.clock() - startTime
            local remaining = math.max(0, FUSE_DURATION - elapsed)
            local progress = math.clamp(elapsed / FUSE_DURATION, 0, 1)

            FuseText.Text = string.format("FUSE: %.2fs", remaining)
            FuseFill.Size = UDim2.new(progress, 0, 1, 0)

            if autoClickEnabled and not clicked and remaining <= activeAutoClickTime then
                clicked = true
                triggerAutoClick()
            end

            if remaining <= 0 then break end
            task.wait()
        end

        FuseText.Text = "FUSE: READY"
        FuseFill.Size = UDim2.new(0, 0, 1, 0)
        isFuseLit = false
    end)
end

--------------------------------------------------------------------------------
-- DETECTORS
--------------------------------------------------------------------------------

local function setupAnimationTracker(char)
    local humanoid = char:WaitForChild("Humanoid", 5)
    if not humanoid then return end

    humanoid.AnimationPlayed:Connect(function(track)
        local animName = track.Name
        if animName == "ReloadP1" then
            triggerReload()
        elseif animName == "Ignite" or animName == "IgniteAim" or animName == "StrikeFlint" or animName == "Aim" or animName == "Aiming" then
            triggerFuse()
        end
    end)
end

if LocalPlayer.Character then setupAnimationTracker(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(setupAnimationTracker)

if hookmetamethod then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if (method == "FireServer" or method == "fireServer") and self.Name == "RemoteEvent" then
            if args[1] == "LightFuse" then triggerFuse() end
        end
        return oldNamecall(self, ...)
    end)
end
