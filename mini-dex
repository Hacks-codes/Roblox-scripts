local workspace = game:GetService("Workspace")
local lighting = game:GetService("Lighting")
local replicatedStorage = game:GetService("ReplicatedStorage")
local guiService = game:GetService("GuiService")
local coreGui = game:GetService("CoreGui")

local DeepContainers = {}

-- Index deep lighting & post-processing instances
pcall(function()
    for _, item in ipairs(lighting:GetChildren()) do
        if item:IsA("PostEffect") or item:IsA("Atmosphere") or item:IsA("Sky") or item:IsA("Clouds") then
            DeepContainers["Light_" .. item.ClassName] = item
        end
    end
end)

-- Index camera-attached runtime instances (ClientRef, local effects)
pcall(function()
    local cam = workspace.CurrentCamera
    if cam then
        for _, child in ipairs(cam:GetChildren()) do
            DeepContainers["Cam_" .. child.Name] = child
        end
    end
end)

-- Index ReplicatedStorage residual sub-trees
pcall(function()
    if replicatedStorage:FindFirstChild("Packages") then
        DeepContainers["RS_Packages"] = replicatedStorage.Packages
    end
    if replicatedStorage:FindFirstChild("Configs") or replicatedStorage:FindFirstChild("Configuration") then
        DeepContainers["RS_Configs"] = replicatedStorage:FindFirstChild("Configs") or replicatedStorage:FindFirstChild("Configuration")
    end
