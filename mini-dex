        DeepContainers["RS_UI"] = replicatedStorage:FindFirstChild("GUI") or replicatedStorage:FindFirstChild("UI")
    end
end)

-- Index specific Workspace debris, dynamic parts, and runtime instances
pcall(function()
    if workspace:FindFirstChild("Effects") or workspace:FindFirstChild("Particles") then
        DeepContainers["World_VFX"] = workspace:FindFirstChild("Effects") or workspace:FindFirstChild("Particles")
    end
    if workspace:FindFirstChild("Ignore") or workspace:FindFirstChild("RaycastIgnore") then
        DeepContainers["RaycastIgnore"] = workspace:FindFirstChild("Ignore") or workspace:FindFirstChild("RaycastIgnore")
