        local descendants = selectedObject:GetDescendants()
        for _, desc in ipairs(descendants) do
            local descData = getObjectDataLines(desc)
            for _, line in ipairs(descData) do table.insert(allLines, line) end
            table.insert(allLines, "\n------------------------------\n")
        end

        local fullString = table.concat(allLines, "\n")
        setclipboard(fullString)

        copyAllBtn.Text = "Copied All!"
        copyAllBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
        task.delay(1.2, function()
            copyAllBtn.Text = "Copy All"
            copyAllBtn.BackgroundColor3 = Color3.fromRGB(200, 80, 40)
        end)
    end
end)

renderDirectory(Workspace)
