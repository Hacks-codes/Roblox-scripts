            sBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
            sBtn.TextSize = 9
            sBtn.Font = Enum.Font.SourceSansBold
            sBtn.Parent = folderScroll

            sBtn.MouseButton1Click:Connect(function()
                MiniDex.RenderDirectory(inst)
            end)
