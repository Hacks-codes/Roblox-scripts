-- Helper Logic
local extendedProps = {
    "ClassName", "Parent", "Name", "Value", "ToolTip", "TextureId", "SoundId", "Volume", "Playing",
    "PrimaryPart", "Health", "MaxHealth", "WalkSpeed", "JumpPower", "JumpHeight",
    "Position", "Size", "Orientation", "Anchored", "CanCollide", "CanQuery", "CanTouch", "Transparency", "Reflectance",
    "Color", "Material", "Disabled", "UserId", "TeamColor", "AutoLoadCharacter", "Archivable"
}

local function getClassColor(inst)
    if inst:IsA("Model") then return Color3.fromRGB(255, 170, 0) end
    if inst:IsA("BasePart") then return Color3.fromRGB(0, 170, 255) end
    if inst:IsA("Humanoid") then return Color3.fromRGB(255, 85, 85) end
    if inst:IsA("Script") or inst:IsA("LocalScript") or inst:IsA("ModuleScript") then return Color3.fromRGB(85, 255, 127) end
    if inst:IsA("ValueBase") then return Color3.fromRGB(255, 255, 127) end
    return Color3.fromRGB(220, 220, 220)
end

function MiniDex.GetExactCodePath(obj)
    if not obj then return "" end
    local pathParts = {}
    local curr = obj

    while curr and curr ~= game do
        local name = curr.Name
        if string.match(name, "^[%a_][%w_]*$") then
            table.insert(pathParts, 1, "." .. name)
        else
            local escaped = string.gsub(name, '"', '\\"')
            table.insert(pathParts, 1, '["' .. escaped .. '"]')
        end
        curr = curr.Parent
    end

    local path = table.concat(pathParts, "")
    if string.sub(path, 1, 1) == "." then path = string.sub(path, 2) end
    local rootName = obj:GetFullName():split(".")[1] or "Workspace"
    return "game:GetService(\"" .. rootName .. "\")" .. string.sub(path, string.len(rootName) + 1)
end

function MiniDex.GetObjectDataLines(obj)
    local lines = {
        "Target: " .. obj.Name,
        "Class: " .. obj.ClassName,
        "Path: " .. obj:GetFullName(),
        "CodePath: " .. MiniDex.GetExactCodePath(obj),
        "------------------------------"
    }

    for _, prop in ipairs(extendedProps) do
        local success, val = pcall(function() return obj[prop] end)
        if success and val ~= nil then
            local strVal = tostring(val)
            if typeof(val) == "Vector3" then
                strVal = string.format("Vector3.new(%.4f, %.4f, %.4f)", val.X, val.Y, val.Z)
            elseif typeof(val) == "Color3" then
                strVal = string.format("Color3.fromRGB(%d, %d, %d)", math.floor(val.R*255), math.floor(val.G*255), math.floor(val.B*255))
            elseif typeof(val) == "Instance" then
                strVal = val:GetFullName()
            end
            table.insert(lines, prop .. ": " .. strVal)
        end
    end

    local attrSuccess, attributes = pcall(function() return obj:GetAttributes() end)
    if attrSuccess and attributes then
        for attrName, attrValue in pairs(attributes) do
            local strVal = tostring(attrValue)
            if typeof(attrValue) == "Vector3" then
                strVal = string.format("Vector3.new(%.4f, %.4f, %.4f)", attrValue.X, attrValue.Y, attrValue.Z)
            elseif typeof(attrValue) == "Color3" then
                strVal = string.format("Color3.fromRGB(%d, %d, %d)", math.floor(attrValue.R*255), math.floor(attrValue.G*255), math.floor(attrValue.B*255))
            end
            table.insert(lines, "[Attr] " .. attrName .. ": " .. strVal)
        end
    end

    return lines
end

-- Refresh Chunk Copy Buttons [1], [2], [3]...
local function updateChunkButtons(obj)
    for _, child in ipairs(chunkScroll:GetChildren()) do
        if not child:IsA("UIListLayout") then child:Destroy() end
    end

    if not obj then return end

    local descendants = obj:GetDescendants()
    table.insert(descendants, 1, obj) -- Include target object itself

    local totalItems = #descendants
    local chunkSize = MiniDex.ExportChunkSize
    local numChunks = math.ceil(totalItems / chunkSize)

    chunkScroll.CanvasSize = UDim2.new(0, numChunks * 32, 0, 0)

    for chunkIdx = 1, numChunks do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 28, 1, 0)
        btn.BackgroundColor3 = Color3.fromRGB(200, 80, 40)
        btn.BorderSizePixel = 0
        btn.Text = tostring(chunkIdx)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 10
        btn.Font = Enum.Font.SourceSansBold
        btn.Parent = chunkScroll

        btn.MouseButton1Click:Connect(function()
            btn.Text = "..."
            task.spawn(function()
                local startIndex = ((chunkIdx - 1) * chunkSize) + 1
                local endIndex = math.min(chunkIdx * chunkSize, totalItems)
                local chunkLines = {
                    string.format("-- EXPORT CHUNK %d/%d (Items %d to %d of %d) --\n", chunkIdx, numChunks, startIndex, endIndex, totalItems)
                }

                for i = startIndex, endIndex do
                    local item = descendants[i]
                    if item then
                        local itemData = MiniDex.GetObjectDataLines(item)
                        for _, line in ipairs(itemData) do table.insert(chunkLines, line) end
                        table.insert(chunkLines, "\n------------------------------\n")
                    end
                    if i % 10 == 0 then task.wait() end -- Yield execution frame
                end

                if setclipboard then
                    setclipboard(table.concat(chunkLines, "\n"))
                    btn.Text = "OK"
                    task.delay(1, function() btn.Text = tostring(chunkIdx) end)
                end
            end)
        end)
    end
end

local function loadProperties(obj)
    MiniDex.SelectedObject = obj
    for _, child in ipairs(propScroll:GetChildren()) do
        if not child:IsA("UIListLayout") then child:Destroy() end
    end
    
    updateChunkButtons(obj)
    if not obj then return end

    local textLines = MiniDex.GetObjectDataLines(obj)
    for _, line in ipairs(textLines) do
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 0, 15)
        label.BackgroundTransparency = 1
        label.TextColor3 = string.find(line, "%[Attr%]") and Color3.fromRGB(255, 215, 0) or string.find(line, "^CodePath:") and Color3.fromRGB(80, 220, 100) or Color3.fromRGB(200, 200, 200)
        label.TextSize = 9
        label.Font = Enum.Font.SourceSans
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Text = " " .. line
        label.Parent = propScroll
    end
    propScroll.CanvasSize = UDim2.new(0, 0, 0, #textLines * 15)
end

function MiniDex.RenderDirectory(target)
    MiniDex.CurrentParent = target
    pathLabel.Text = " " .. target:GetFullName()

    for _, v in ipairs(explorerScroll:GetChildren()) do
        if not v:IsA("UIListLayout") then v:Destroy() end
    end

    local children = target:GetChildren()
    explorerScroll.CanvasSize = UDim2.new(0, 0, 0, #children * 20)

    for i, child in ipairs(children) do
        local itemFrame = Instance.new("Frame")
        itemFrame.Size = UDim2.new(1, 0, 0, 20)
        itemFrame.BackgroundColor3 = (i % 2 == 0) and Color3.fromRGB(15, 15, 15) or Color3.fromRGB(22, 22, 22)
        itemFrame.BorderSizePixel = 0
        itemFrame.Parent = explorerScroll

        local hasChildren = #child:GetChildren() > 0
        local expandBtn = Instance.new("TextButton")
        expandBtn.Size = UDim2.new(0, 24, 1, 0)
        expandBtn.BackgroundTransparency = 1
        expandBtn.Text = hasChildren and "[+]" or "  "
        expandBtn.TextColor3 = Color3.fromRGB(255, 180, 50)
        expandBtn.TextSize = 9
        expandBtn.Font = Enum.Font.SourceSansBold
        expandBtn.Parent = itemFrame

        expandBtn.MouseButton1Click:Connect(function()
            if hasChildren then MiniDex.RenderDirectory(child) end
        end)

        local selectBtn = Instance.new("TextButton")
        selectBtn.Size = UDim2.new(1, -24, 1, 0)
        selectBtn.Position = UDim2.new(0, 24, 0, 0)
        selectBtn.BackgroundTransparency = 1
        selectBtn.Text = string.format("%s (%s)", child.Name, child.ClassName)
        selectBtn.TextColor3 = getClassColor(child)
        selectBtn.TextSize = 9
        selectBtn.Font = Enum.Font.SourceSans
        selectBtn.TextXAlignment = Enum.TextXAlignment.Left
        selectBtn.ClipsDescendants = true
        selectBtn.Parent = itemFrame

        selectBtn.MouseButton1Click:Connect(function()
            loadProperties(child)
        end)
    end
end

